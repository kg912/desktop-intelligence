# Copy to .env.e2e.local (gitignored) and fill in. Used only by scripts/e2e/di.mjs,
# which seeds a throwaway profile under /tmp/di-e2e — your real app settings are untouched.
# Leave a provider's lines empty to skip that provider.

# LM Studio (local, http://localhost:1234 — must be running)
LMSTUDIO_MODEL=mlx-community/Qwen3.5-35B-A3B-6bit
LMSTUDIO_CONTEXT=32768

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Ollama (cloud: https://ollama.com + key; local: http://localhost:11434, no key)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=

# MTPLX (local — must be running)
MTPLX_BASE_URL=http://localhost:8000
MTPLX_MODEL=

# NVIDIA Build (optional)
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Optional: enables Brave web search in every seeded profile
BRAVE_SEARCH_API_KEY=
